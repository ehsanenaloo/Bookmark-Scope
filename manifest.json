{
  "manifest_version": 3,
  "name": "Bookmark Manager per Domain and Page",
  "version": "4.6.7",
  "description": "Compact bookmark triage in the popup, plus a full Library Dashboard for health scans, reminders, cleanup recommendations, and deep maintenance across your whole bookmark collection.",
  "permissions": [
    "tabs",
    "bookmarks",
    "storage",
    "clipboardWrite",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Manager",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}